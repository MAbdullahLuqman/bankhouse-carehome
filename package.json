{
  "name": "bank-house-care-home",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulator": "FIREBASE_USE_EMULATOR=true FIREBASE_PROJECT_ID=demo-bank-house FIREBASE_API_KEY=demo-key FIREBASE_ADMIN_EMAILS=admin@bankhouse.local FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 next dev",
    "firebase:emulators": "npx firebase-tools emulators:start --project demo-bank-house --only auth,firestore --import=./.firebase/emulator-data --export-on-exit",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:site": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
